{
  "name": "simlab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "upstream:fetch": "node tools/src/upstream/fetch.ts",
    "bench:fork": "node tools/src/bench/fork.ts",
    "bench:schema": "node tools/src/bench/schema.ts",
    "transcript:capture": "node tools/src/transcript/capture.ts",
    "oracle": "node tools/src/oracle/cli.ts",
    "golden:capture": "node tools/src/golden/capture.ts",
    "golden:kubectl-manifest": "node tools/src/golden/kubectl_manifest.ts",
    "kubeadm:capture": "node tools/src/kubeadm/capture.ts",
    "images:capture": "node tools/src/images/capture.ts",
    "api:vendor": "node tools/src/openapi/vendor.ts",
    "play": "node apps/cli/src/play.ts",
    "sim": "node apps/cli/src/sim.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
