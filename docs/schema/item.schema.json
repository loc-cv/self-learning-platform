{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlab.invalid/schema/item.schema.json",
  "title": "Simlab lab-like content item (lab, drill, incident)",
  "description": "Specified in docs/SCENARIO_FORMAT.md. The check, fault and step catalogs in $defs are the phase 00 catalog; from phase 09 they are generated from the plugin registry.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "kind": {
      "enum": [
        "lab",
        "drill",
        "incident"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
      }
    },
    "curriculum": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(cka|ckad)\\.[a-z]+\\.[a-z0-9-]+$"
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "targetMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "world": {
      "type": "object",
      "properties": {
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "topologyParams": {
          "type": "object"
        },
        "startTime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "entry": {
          "type": "object",
          "properties": {
            "machine": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "machine",
            "user"
          ],
          "additionalProperties": false
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "pick": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "pick"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "int": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "int"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        },
        "setup": {
          "$ref": "#/$defs/steps"
        }
      },
      "required": [
        "topology",
        "setup"
      ],
      "additionalProperties": false
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "solutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/steps"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "$ref": "#/$defs/steps"
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            },
            "required": [
              "name",
              "steps"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "debrief": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "skills",
    "curriculum",
    "difficulty",
    "targetMinutes",
    "world",
    "ticket",
    "hints",
    "checks",
    "solutions",
    "debrief"
  ],
  "additionalProperties": false,
  "$defs": {
    "when": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "minItems": 1
          }
        ]
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "assertion": {
      "type": "object",
      "properties": {
        "assert": {
          "enum": [
            "shell.exec",
            "host.file",
            "host.unit",
            "net.reach",
            "k8s.object",
            "k8s.podsReady",
            "k8s.rollout",
            "k8s.nodeReady",
            "k8s.nodeHasTaint",
            "k8s.endpoints",
            "k8s.can"
          ]
        },
        "with": {
          "type": "object"
        },
        "not": {
          "type": "boolean"
        }
      },
      "required": [
        "assert",
        "with"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "assert": {
                "const": "shell.exec"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "run": {
                    "type": "string",
                    "minLength": 1
                  },
                  "on": {
                    "type": "string",
                    "minLength": 1
                  },
                  "as": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exit": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "stdout": {
                    "type": "object",
                    "properties": {
                      "equals": {
                        "type": "string"
                      },
                      "contains": {
                        "type": "string",
                        "minLength": 1
                      },
                      "notContains": {
                        "type": "string",
                        "minLength": 1
                      },
                      "matches": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [],
                    "additionalProperties": false,
                    "minProperties": 1
                  },
                  "stderr": {
                    "type": "object",
                    "properties": {
                      "equals": {
                        "type": "string"
                      },
                      "contains": {
                        "type": "string",
                        "minLength": 1
                      },
                      "notContains": {
                        "type": "string",
                        "minLength": 1
                      },
                      "matches": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [],
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "required": [
                  "run"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "host.file"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "on": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "type": {
                    "enum": [
                      "file",
                      "dir",
                      "symlink"
                    ]
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "matches": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "type": "string",
                    "pattern": "^[0-7]{3,4}$"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "group": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "on",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "host.unit"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "on": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "on",
                  "unit"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "net.reach"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "from": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "machine": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "machine"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "pod": {
                            "type": "object",
                            "properties": {
                              "namespace": {
                                "type": "string",
                                "minLength": 1
                              },
                              "selector": {
                                "type": "string",
                                "minLength": 1
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "namespace"
                            ],
                            "additionalProperties": false,
                            "minProperties": 2
                          }
                        },
                        "required": [
                          "pod"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expect": {
                    "enum": [
                      "answered",
                      "refused",
                      "timeout",
                      "unresolved"
                    ]
                  },
                  "status": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "bodyContains": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.object"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "apiVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "count": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "min": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "max": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "where": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "equals": {},
                        "notEquals": {},
                        "in": {
                          "type": "array",
                          "minItems": 1
                        },
                        "contains": {
                          "type": "string",
                          "minLength": 1
                        },
                        "matches": {
                          "type": "string",
                          "minLength": 1
                        },
                        "exists": {
                          "type": "boolean"
                        },
                        "gte": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "lte": {
                          "type": [
                            "number",
                            "string"
                          ]
                        }
                      },
                      "required": [
                        "path"
                      ],
                      "additionalProperties": false,
                      "minProperties": 2
                    }
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.podsReady"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "min": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "max": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  }
                },
                "required": [
                  "namespace",
                  "selector"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.rollout"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "Deployment",
                      "StatefulSet",
                      "DaemonSet"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "namespace",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.nodeReady"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ready": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "node"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.nodeHasTaint"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effect": {
                    "enum": [
                      "NoSchedule",
                      "PreferNoSchedule",
                      "NoExecute"
                    ]
                  }
                },
                "required": [
                  "nodes",
                  "key"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.endpoints"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "min": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  },
                  "max": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                      }
                    ]
                  }
                },
                "required": [
                  "namespace",
                  "service"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assert": {
                "const": "k8s.can"
              }
            },
            "required": [
              "assert"
            ]
          },
          "then": {
            "properties": {
              "with": {
                "type": "object",
                "properties": {
                  "as": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verb": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "as",
                  "verb",
                  "resource"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            },
            "on": {
              "type": "string",
              "minLength": 1
            },
            "as": {
              "type": "string",
              "minLength": 1
            },
            "expect": {
              "type": "object",
              "properties": {
                "exit": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\{\\{[a-z][a-zA-Z0-9]*\\}\\}$"
                    }
                  ]
                }
              },
              "required": [
                "exit"
              ],
              "additionalProperties": false
            },
            "editor": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string",
                            "minLength": 1
                          },
                          "to": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "write": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "write"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "when": {
              "$ref": "#/$defs/when"
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "apply": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "$ref": "#/$defs/when"
            }
          },
          "required": [
            "apply"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "write": {
              "type": "object",
              "properties": {
                "path": {
