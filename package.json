{
  "name": "simlab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test && npm run content:check",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "upstream:fetch": "node tools/src/upstream/fetch.ts",
    "bench:fork": "node tools/src/bench/fork.ts",
    "bench:schema": "node tools/src/bench/schema.ts",
    "bench:kubectl": "node tools/src/bench/kubectl.ts",
    "transcript:capture": "node tools/src/transcript/capture.ts",
    "oracle": "node tools/src/oracle/cli.ts",
    "golden:capture": "node tools/src/golden/capture.ts",
    "golden:kubectl-manifest": "node tools/src/golden/kubectl_manifest.ts",
    "golden:diff": "node tools/src/golden/kubectl/report.ts",
    "gaps:summary": "node tools/src/gaps/summary.ts",
    "fidelity:report": "node tools/src/fidelity/report.ts",
    "coverage:generate": "node tools/src/coverage/generate.ts",
    "kubeadm:capture": "node tools/src/kubeadm/capture.ts",
    "images:capture": "node tools/src/images/capture.ts",
    "api:vendor": "node tools/src/openapi/vendor.ts",
    "openapi:capture": "node tools/src/openapi/capture.ts",
    "play": "node apps/cli/src/play.ts",
    "sim": "node apps/cli/src/sim.ts",
    "lab": "node apps/cli/src/lab.ts",
    "content:check": "node tools/src/content/check.ts",
    "content:schema": "node tools/src/content/schema.ts",
    "content:i18n": "node tools/src/content/i18n.ts",
    "dev": "node apps/server/src/main.ts --dev",
    "start": "npm run build -w apps/web && node apps/server/src/main.ts",
    "e2e": "npm run e2e -w apps/web",
    "bench:web": "npm run e2e -w apps/web -- latency"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
